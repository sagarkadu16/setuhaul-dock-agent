# Copy to .env (make setup does this) and fill in your key.

# LLM: any OpenAI-compatible API. Default is OpenRouter (https://openrouter.ai/keys).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# A model that supports tool calling, in the provider's naming (e.g. "vendor/model-name").
# Pinned in task T4.1 (checked with scripts/check_llm.py).
LLM_MODEL=openai/gpt-4.1-mini

# Simulated "now" for all scheduling logic (spec A3). The seed data is a snapshot of this morning.
APP_CLOCK=2026-08-04T09:40:00+05:30

# Signs the login cookie. Any long random string.
SESSION_SECRET=change-me

# Where the databases live (relative to the repo root).
APP_DB_PATH=data/app.db
CHECKPOINT_DB_PATH=data/checkpoints.db
